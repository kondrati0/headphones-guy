#include <winver.h>
1 ICON "guy.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Headphones Guy"
      VALUE "FileDescription",  "Headphones Guy - a taskbar smiley that nods to your music"
      VALUE "FileVersion",      "1.0.0"
      VALUE "InternalName",     "HeadphonesGuy"
      VALUE "OriginalFilename", "HeadphonesGuy.exe"
      VALUE "ProductName",      "Headphones Guy"
      VALUE "ProductVersion",   "1.0.0"
      VALUE "LegalCopyright",   "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
