#include <winver.h>
// HG_V1..HG_V3 and HG_VS come from the VERSION file, see build.sh
1 ICON "guy.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     HG_V1,HG_V2,HG_V3,0
PRODUCTVERSION  HG_V1,HG_V2,HG_V3,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Headphones Guy"
      VALUE "FileDescription",  "Headphones Guy - a taskbar smiley that nods to your music"
      VALUE "FileVersion",      HG_VS
      VALUE "InternalName",     "HeadphonesGuy"
      VALUE "OriginalFilename", "HeadphonesGuy.exe"
      VALUE "ProductName",      "Headphones Guy"
      VALUE "ProductVersion",   HG_VS
      VALUE "LegalCopyright",   "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
